#include <Servo.h>
#include <Keypad.h>

// -------- SERVOS --------
Servo servo1;
Servo servo2;
Servo servo3;
Servo servo4;

#define SERVO1_PIN 5
#define SERVO2_PIN 13
#define SERVO3_PIN 12
#define SERVO4_PIN 11

// -------- KEYPAD SETUP --------
const byte ROWS = 4;
const byte COLS = 4;

char keys[ROWS][COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};

byte rowPins[ROWS] = {A5, A4, A3, A2};
byte colPins[COLS] = {4, 3, 2, 9};

Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

// -------- SETUP --------
void setup() {
  servo1.attach(SERVO1_PIN);
  servo2.attach(SERVO2_PIN);
  servo3.attach(SERVO3_PIN);
  servo4.attach(SERVO4_PIN);

  Serial.begin(9600);
}

//int pos = 0;

// -------- LOOP --------
void loop() {
  char key = keypad.getKey();

  if (key) {
    Serial.println(key);

    switch (key) {

      case '1':
        servo1.write(90);
        delay(50);
        servo1.write(0);
        break;

      case '2':
        servo2.write(0);
        delay(50);
        servo2.write(90);
        break;

      case '3':
          servo3.write(90);
          delay(50);
          servo3.write(0);
          break;
      case '4':
        servo4.write(0);
        delay(50);
        servo4.write(120);
        break;
    }
  }
}
